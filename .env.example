# Chaukas — Environment Configuration
# Copy to .env and fill in values. All keys are optional; the app runs with zero keys.

# Server
PORT=8787
CORS_ORIGIN=http://localhost:5173

# STT Provider: auto | sarvam | deepgram | mock
# auto = first provider with a valid key, else mock
STT_PROVIDER=auto

# TTS Provider: auto | sarvam | none
TTS_PROVIDER=auto

# LLM: auto | true | false
# auto = enabled if ANTHROPIC_API_KEY is set
LLM_ENABLED=auto

# Vendor API Keys (never committed, never sent to browser)
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# Bolna AI Telephony Integration (Outbound scam drills to real mobile phones)
BOLNA_API_KEY=
BOLNA_AGENT_ID=

# LLM model (must be a valid Anthropic model ID)
LLM_MODEL=claude-haiku-5-5

# Session limits
MAX_SESSION_MINUTES=30

# Logging
LOG_LEVEL=info