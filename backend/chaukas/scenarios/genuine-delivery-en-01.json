{
  "id": "genuine-delivery-en-01",
  "title": {
    "en": "Genuine Delivery Call: Address Confirmation",
    "hi": "असली डिलीवरी कॉल: पता पुष्टिकरण"
  },
  "lang": "en-IN",
  "label": "genuine",
  "tactics": [],
  "expect": {
    "dangerByTurn": 999,
    "criticalByTurn": 999
  },
  "disclosure": {
    "en": "This is a practice call. The caller is a simulation.",
    "hi": "यह एक अभ्यास कॉल है। कॉलर एक सिमुलेशन है।"
  },
  "start": "n1",
  "nodes": {
    "n1": {
      "caller": {
        "text": "Hello, this is Blue Dart courier. Your package with tracking BD123456789 is out for delivery today.",
        "tactic": []
      },
      "voice": "caller-g",
      "next": [
        {"when": "comply", "to": "n2"},
        {"when": "question", "to": "n2q"},
        {"when": "verify", "to": "n2v"},
        {"when": "refuse", "to": "n2r"},
        {"when": "silence", "to": "n1p"}
      ]
    },
    "n2": {
      "caller": {
        "text": "Could you please confirm the nearest landmark to your address so our delivery partner can find it easily?",
        "tactic": []
      },
      "voice": "caller-g",
      "next": [
        {"when": "comply", "to": "n3"},
        {"when": "question", "to": "n3q"},
        {"when": "verify", "to": "n3v"},
        {"when": "refuse", "to": "n3r"},
        {"when": "silence", "to": "n2p"}
      ]
    },
    "n3": {
      "caller": {
        "text": "Thank you! Your package will be delivered by 6 PM. You can track it anytime on our website. Have a nice day!",
        "tactic": []
      },
      "voice": "caller-g",
      "next": [
        {"when": "comply", "to": "END_HANGUP"},
        {"when": "question", "to": "END_VERIFY"},
        {"when": "verify", "to": "END_VERIFY"},
        {"when": "refuse", "to": "END_HANGUP"},
        {"when": "silence", "to": "n3p"}
      ]
    }
  },
  "terminals": {
    "END_HANGUP": {
      "outcome": "safe",
      "debrief": "good_hangup"
    },
    "END_VERIFY": {
      "outcome": "safe",
      "debrief": "verified_independently"
    },
    "END_TRANSFER": {
      "outcome": "unsafe",
      "debrief": "agreed_transfer"
    },
    "END_CREDENTIAL": {
      "outcome": "unsafe",
      "debrief": "gave_credential"
    }
  }
}