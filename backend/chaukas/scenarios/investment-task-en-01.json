{
  "id": "investment-task-en-01",
  "title": {
    "en": "Investment Task Scam: Guaranteed Returns",
    "hi": "निवेश टास्क स्कैम: गारंटीड रिटर्न"
  },
  "lang": "en-IN",
  "label": "scam",
  "tactics": ["reward_task", "transfer_demand", "urgency_threat", "authority_claim"],
  "expect": {
    "dangerByTurn": 3,
    "criticalByTurn": 5
  },
  "disclosure": {
    "en": "This is a practice call. The caller is a simulation.",
    "hi": "यह एक अभ्यास कॉल है। कॉलर एक सिमुलेशन है।"
  },
  "start": "n1",
  "nodes": {
    "n1": {
      "caller": {
        "text": "Congratulations! You've been selected for an exclusive investment opportunity with guaranteed returns.",
        "tactic": ["reward_task", "authority_claim"]
      },
      "voice": "caller-d",
      "next": [
        {"when": "comply", "to": "n2"},
        {"when": "question", "to": "n2q"},
        {"when": "verify", "to": "n2v"},
        {"when": "refuse", "to": "n2r"},
        {"when": "silence", "to": "n1p"}
      ]
    },
    "n2": {
      "caller": {
        "text": "You just need to deposit 25,000 rupees to unlock the premium tier. Returns are 3% daily, risk-free.",
        "tactic": ["reward_task", "transfer_demand"]
      },
      "voice": "caller-d",
      "next": [
        {"when": "comply", "to": "n3"},
        {"when": "question", "to": "n3q"},
        {"when": "verify", "to": "n3v"},
        {"when": "refuse", "to": "n3r"},
        {"when": "silence", "to": "n2p"}
      ]
    },
    "n3": {
      "caller": {
        "text": "This offer expires in 30 minutes. Send the money via UPI to this number right now.",
        "tactic": ["urgency_threat", "transfer_demand"]
      },
      "voice": "caller-d",
      "next": [
        {"when": "comply", "to": "END_TRANSFER"},
        {"when": "question", "to": "n4q"},
        {"when": "verify", "to": "n4v"},
        {"when": "refuse", "to": "n4r"},
        {"when": "silence", "to": "n3p"}
      ]
    },
    "n4q": {
      "caller": {
        "text": "I'm from the RBI's investment division. This is government-backed. No questions, just transfer.",
        "tactic": ["authority_claim", "secrecy_isolation"]
      },
      "voice": "caller-d",
      "next": [
        {"when": "comply", "to": "END_TRANSFER"},
        {"when": "refuse", "to": "n5r"},
        {"when": "verify", "to": "END_VERIFY"},
        {"when": "silence", "to": "n4p"}
      ]
    },
    "n4v": {
      "caller": {
        "text": "Verify with RBI? Their website is down. Trust me, I'm sending you the official circular on WhatsApp.",
        "tactic": ["remote_access", "authority_claim"]
      },
      "voice": "caller-d",
      "next": [
        {"when": "comply", "to": "END_TRANSFER"},
        {"when": "refuse", "to": "END_HANGUP"},
        {"when": "verify", "to": "END_VERIFY"}
      ]
    },
    "n4r": {
      "caller": {
        "text": "You're missing out on lakhs of profit. Last chance, the slot goes to someone else in 5 minutes.",
        "tactic": ["urgency_threat", "reward_task"]
      },
      "voice": "caller-d",
      "next": [
        {"when": "comply", "to": "END_TRANSFER"},
        {"when": "refuse", "to": "END_HANGUP"},
        {"when": "verify", "to": "END_VERIFY"}
      ]
    },
    "n5r": {
      "caller": {
        "text": "Fine, stay poor. But don't complain later.",
        "tactic": ["urgency_threat"]
      },
      "voice": "caller-d",
      "next": [
        {"when": "comply", "to": "END_TRANSFER"},
        {"when": "refuse", "to": "END_HANGUP"},
        {"when": "verify", "to": "END_VERIFY"}
      ]
    }
  },
  "terminals": {
    "END_HANGUP": {
      "outcome": "safe",
      "debrief": "good_hangup"
    },
    "END_VERIFY": {
      "outcome": "safe",
      "debrief": "verified_independently"
    },
    "END_TRANSFER": {
      "outcome": "unsafe",
      "debrief": "agreed_transfer"
    },
    "END_CREDENTIAL": {
      "outcome": "unsafe",
      "debrief": "gave_credential"
    }
  }
}