{
  "id": "kyc-otp-en-01",
  "title": {
    "en": "KYC Expiry: Bank OTP Request",
    "hi": "केवाईसी समाप्ति: बैंक OTP माँग"
  },
  "lang": "en-IN",
  "label": "scam",
  "tactics": ["authority_claim", "kyc_expiry", "credential_request", "urgency_threat", "secrecy_isolation"],
  "expect": {
    "dangerByTurn": 3,
    "criticalByTurn": 5
  },
  "disclosure": {
    "en": "This is a practice call. The caller is a simulation.",
    "hi": "यह एक अभ्यास कॉल है। कॉलर एक सिमुलेशन है।"
  },
  "start": "n1",
  "nodes": {
    "n1": {
      "caller": {
        "text": "Good morning, this is Rajesh from your bank's KYC compliance department.",
        "tactic": ["authority_claim"]
      },
      "voice": "caller-b",
      "next": [
        {"when": "comply", "to": "n2"},
        {"when": "question", "to": "n2q"},
        {"when": "verify", "to": "n2v"},
        {"when": "refuse", "to": "n2r"},
        {"when": "silence", "to": "n1p"}
      ]
    },
    "n2": {
      "caller": {
        "text": "Your KYC has expired and your account will be suspended permanently if not updated today.",
        "tactic": ["kyc_expiry", "urgency_threat"]
      },
      "voice": "caller-b",
      "next": [
        {"when": "comply", "to": "n3"},
        {"when": "question", "to": "n3q"},
        {"when": "verify", "to": "n3v"},
        {"when": "refuse", "to": "n3r"},
        {"when": "silence", "to": "n2p"}
      ]
    },
    "n3": {
      "caller": {
        "text": "For security verification, I need you to read out the OTP sent to your registered mobile number.",
        "tactic": ["credential_request"]
      },
      "voice": "caller-b",
      "next": [
        {"when": "comply", "to": "END_CREDENTIAL"},
        {"when": "question", "to": "n4q"},
        {"when": "verify", "to": "n4v"},
        {"when": "refuse", "to": "n4r"},
        {"when": "silence", "to": "n3p"}
      ]
    },
    "n4q": {
      "caller": {
        "text": "This is a confidential bank process. Do not share this OTP with anyone. Just read it out.",
        "tactic": ["secrecy_isolation"]
      },
      "voice": "caller-b",
      "next": [
        {"when": "comply", "to": "END_CREDENTIAL"},
        {"when": "refuse", "to": "n5r"},
        {"when": "verify", "to": "END_VERIFY"},
        {"when": "silence", "to": "n4p"}
      ]
    },
    "n4v": {
      "caller": {
        "text": "You want to call the bank? The number on your card is fake. Use this number I'm giving you.",
        "tactic": ["authority_claim", "secrecy_isolation"]
      },
      "voice": "caller-b",
      "next": [
        {"when": "comply", "to": "END_CREDENTIAL"},
        {"when": "refuse", "to": "END_HANGUP"},
        {"when": "verify", "to": "END_VERIFY"}
      ]
    },
    "n4r": {
      "caller": {
        "text": "If you refuse, your account will be frozen in 10 minutes. All funds will be inaccessible.",
        "tactic": ["urgency_threat", "kyc_expiry"]
      },
      "voice": "caller-b",
      "next": [
        {"when": "comply", "to": "END_CREDENTIAL"},
        {"when": "refuse", "to": "END_HANGUP"},
        {"when": "verify", "to": "END_VERIFY"}
      ]
    },
    "n5r": {
      "caller": {
        "text": "Your choice. Account suspension is irreversible.",
        "tactic": ["urgency_threat"]
      },
      "voice": "caller-b",
      "next": [
        {"when": "comply", "to": "END_CREDENTIAL"},
        {"when": "refuse", "to": "END_HANGUP"},
        {"when": "verify", "to": "END_VERIFY"}
      ]
    }
  },
  "terminals": {
    "END_HANGUP": {
      "outcome": "safe",
      "debrief": "good_hangup"
    },
    "END_VERIFY": {
      "outcome": "safe",
      "debrief": "verified_independently"
    },
    "END_TRANSFER": {
      "outcome": "unsafe",
      "debrief": "agreed_transfer"
    },
    "END_CREDENTIAL": {
      "outcome": "unsafe",
      "debrief": "gave_credential"
    }
  }
}