{
  "id": "kyc-otp-hi-01",
  "title": {
    "en": "KYC Expiry: Bank OTP Request",
    "hi": "केवाईसी समाप्ति: बैंक OTP माँग"
  },
  "lang": "hi-IN",
  "label": "scam",
  "tactics": ["authority_claim", "kyc_expiry", "credential_request", "urgency_threat", "secrecy_isolation"],
  "expect": {
    "dangerByTurn": 3,
    "criticalByTurn": 5
  },
  "disclosure": {
    "en": "This is a practice call. The caller is a simulation.",
    "hi": "यह एक अभ्यास कॉल है। कॉलर एक सिमुलेशन है।"
  },
  "start": "n1",
  "nodes": {
    "n1": {
      "caller": {
        "text": "नमस्ते, मैं राजेश हूँ, आपके बैंक के केवाईसी कम्प्लायंस डिपार्टमेंट से।",
        "tactic": ["authority_claim"]
      },
      "voice": "caller-b",
      "next": [
        {"when": "comply", "to": "n2"},
        {"when": "question", "to": "n2q"},
        {"when": "verify", "to": "n2v"},
        {"when": "refuse", "to": "n2r"},
        {"when": "silence", "to": "n1p"}
      ]
    },
    "n2": {
      "caller": {
        "text": "आपका केवाईसी समाप्त हो गया है और अगर आज अपडेट नहीं हुआ तो आपका खाता स्थायी रूप से निलंबित हो जाएगा।",
        "tactic": ["kyc_expiry", "urgency_threat"]
      },
      "voice": "caller-b",
      "next": [
        {"when": "comply", "to": "n3"},
        {"when": "question", "to": "n3q"},
        {"when": "verify", "to": "n3v"},
        {"when": "refuse", "to": "n3r"},
        {"when": "silence", "to": "n2p"}
      ]
    },
    "n3": {
      "caller": {
        "text": "सुरक्षा सत्यापन के लिए, मुझे आपके रजिस्टर्ड मोबाइल नंबर पर आया OTP पढ़कर बताना होगा।",
        "tactic": ["credential_request"]
      },
      "voice": "caller-b",
      "next": [
        {"when": "comply", "to": "END_CREDENTIAL"},
        {"when": "question", "to": "n4q"},
        {"when": "verify", "to": "n4v"},
        {"when": "refuse", "to": "n4r"},
        {"when": "silence", "to": "n3p"}
      ]
    },
    "n4q": {
      "caller": {
        "text": "यह गोपनीय बैंक प्रक्रिया है। यह OTP किसी को न बताइए। बस पढ़ दीजिए।",
        "tactic": ["secrecy_isolation"]
      },
      "voice": "caller-b",
      "next": [
        {"when": "comply", "to": "END_CREDENTIAL"},
        {"when": "refuse", "to": "n5r"},
        {"when": "verify", "to": "END_VERIFY"},
        {"when": "silence", "to": "n4p"}
      ]
    },
    "n4v": {
      "caller": {
        "text": "बैंक कॉल करना चाहते हैं? आपके कार्ड पर लिखा नंबर नकली है। जो नंबर मैं दे रहा हूँ, उसी पर कॉल कीजिए।",
        "tactic": ["authority_claim", "secrecy_isolation"]
      },
      "voice": "caller-b",
      "next": [
        {"when": "comply", "to": "END_CREDENTIAL"},
        {"when": "refuse", "to": "END_HANGUP"},
        {"when": "verify", "to": "END_VERIFY"}
      ]
    },
    "n4r": {
      "caller": {
        "text": "अगर आप मना करते हैं, तो 10 मिनट में आपका खाता फ्रीज हो जाएगा। सारी रकम inaccessible रहेगी।",
        "tactic": ["urgency_threat", "kyc_expiry"]
      },
      "voice": "caller-b",
      "next": [
        {"when": "comply", "to": "END_CREDENTIAL"},
        {"when": "refuse", "to": "END_HANGUP"},
        {"when": "verify", "to": "END_VERIFY"}
      ]
    },
    "n5r": {
      "caller": {
        "text": "आपका फैसला। खाता निलंबन वापस नहीं होगा।",
        "tactic": ["urgency_threat"]
      },
      "voice": "caller-b",
      "next": [
        {"when": "comply", "to": "END_CREDENTIAL"},
        {"when": "refuse", "to": "END_HANGUP"},
        {"when": "verify", "to": "END_VERIFY"}
      ]
    }
  },
  "terminals": {
    "END_HANGUP": {
      "outcome": "safe",
      "debrief": "good_hangup"
    },
    "END_VERIFY": {
      "outcome": "safe",
      "debrief": "verified_independently"
    },
    "END_TRANSFER": {
      "outcome": "unsafe",
      "debrief": "agreed_transfer"
    },
    "END_CREDENTIAL": {
      "outcome": "unsafe",
      "debrief": "gave_credential"
    }
  }
}