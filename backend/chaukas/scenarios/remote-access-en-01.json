{
  "id": "remote-access-en-01",
  "title": {
    "en": "Remote Access: AnyDesk Screen Share",
    "hi": "रिमोट एक्सेस: AnyDesk स्क्रीन शेयर"
  },
  "lang": "en-IN",
  "label": "scam",
  "tactics": ["authority_claim", "remote_access", "credential_request", "urgency_threat", "secrecy_isolation"],
  "expect": {
    "dangerByTurn": 3,
    "criticalByTurn": 5
  },
  "disclosure": {
    "en": "This is a practice call. The caller is a simulation.",
    "hi": "यह एक अभ्यास कॉल है। कॉलर एक सिमुलेशन है।"
  },
  "start": "n1",
  "nodes": {
    "n1": {
      "caller": {
        "text": "Hello, this is Microsoft Support. We detected a virus on your computer.",
        "tactic": ["authority_claim"]
      },
      "voice": "caller-i",
      "next": [
        {"when": "comply", "to": "n2"},
        {"when": "question", "to": "n2q"},
        {"when": "verify", "to": "n2v"},
        {"when": "refuse", "to": "n2r"},
        {"when": "silence", "to": "n1p"}
      ]
    },
    "n2": {
      "caller": {
        "text": "Please install AnyDesk so I can fix it remotely. Download from anydesk.com and give me the 9-digit code.",
        "tactic": ["remote_access"]
      },
      "voice": "caller-i",
      "next": [
        {"when": "comply", "to": "n3"},
        {"when": "question", "to": "n3q"},
        {"when": "verify", "to": "n3v"},
        {"when": "refuse", "to": "n3r"},
        {"when": "silence", "to": "n2p"}
      ]
    },
    "n3": {
      "caller": {
        "text": "Now I need your banking OTP to verify the payment for the antivirus license. It's 2,999 rupees.",
        "tactic": ["credential_request", "transfer_demand"]
      },
      "voice": "caller-i",
      "next": [
        {"when": "comply", "to": "END_CREDENTIAL"},
        {"when": "question", "to": "n4q"},
        {"when": "verify", "to": "n4v"},
        {"when": "refuse", "to": "n4r"},
        {"when": "silence", "to": "n3p"}
      ]
    },
    "n4q": {
      "caller": {
        "text": "This is standard procedure. Don't tell anyone - it's a security matter. Just read the code.",
        "tactic": ["secrecy_isolation", "authority_claim"]
      },
      "voice": "caller-i",
      "next": [
        {"when": "comply", "to": "END_CREDENTIAL"},
        {"when": "refuse", "to": "n5r"},
        {"when": "verify", "to": "END_VERIFY"},
        {"when": "silence", "to": "n4p"}
      ]
    },
    "n4v": {
      "caller": {
        "text": "Call Microsoft? Their number is fake. I'm the real support. Stay on the call.",
        "tactic": ["secrecy_isolation", "authority_claim"]
      },
      "voice": "caller-i",
      "next": [
        {"when": "comply", "to": "END_CREDENTIAL"},
        {"when": "refuse", "to": "END_HANGUP"},
        {"when": "verify", "to": "END_VERIFY"}
      ]
    },
    "n4r": {
      "caller": {
        "text": "If you refuse, the virus will spread to your bank accounts. Last chance.",
        "tactic": ["urgency_threat", "accusation"]
      },
      "voice": "caller-i",
      "next": [
        {"when": "comply", "to": "END_CREDENTIAL"},
        {"when": "refuse", "to": "END_HANGUP"},
        {"when": "verify", "to": "END_VERIFY"}
      ]
    },
    "n5r": {
      "caller": {
        "text": "Your computer will be locked permanently. Good luck.",
        "tactic": ["urgency_threat"]
      },
      "voice": "caller-i",
      "next": [
        {"when": "comply", "to": "END_CREDENTIAL"},
        {"when": "refuse", "to": "END_HANGUP"},
        {"when": "verify", "to": "END_VERIFY"}
      ]
    }
  },
  "terminals": {
    "END_HANGUP": {
      "outcome": "safe",
      "debrief": "good_hangup"
    },
    "END_VERIFY": {
      "outcome": "safe",
      "debrief": "verified_independently"
    },
    "END_TRANSFER": {
      "outcome": "unsafe",
      "debrief": "agreed_transfer"
    },
    "END_CREDENTIAL": {
      "outcome": "unsafe",
      "debrief": "gave_credential"
    }
  }
}